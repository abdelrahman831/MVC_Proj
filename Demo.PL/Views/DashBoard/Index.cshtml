@model DashBoardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">


<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Dashboard Overview</h1>
            <p class="text-muted small mb-0">Welcome back, @User.Identity.Name</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm">
                <i class="fas fa-bell me-1"></i> Notifications
            </button>
        </div>
    </div>

    <!-- Stats Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Total Users</h6>
                            <h3 class="mb-0">
                                @Model.TotalUsers
                            </h3>
                            <small class="text-success">
                                <i class="fas fa-arrow-up me-1"></i>@Model.RegisteredUsersToday
                            </small>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded">
                            <i class="fas fa-users text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Active Users</h6>
                            <h3 class="mb-0">@Model.LoggedInUsers</h3>
                            <small class="text-success">
                                @* <i class="fas fa-arrow-up me-1"></i> *@
                            </small>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded">
                            <i class="fa-solid fa-user-clock"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Total Departments</h6>
                            <h3 class="mb-0">@Model.TotalDepartments</h3>
                            <small class="text-danger">
                                @* <i class="fas fa-arrow-down me-1"></i> *@
                            </small>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded">
                            <i class="fas fa-building text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-2">Total Employees</h6>
                            <h3 class="mb-0">@Model.TotalEmployees</h3>
                            <small class="text-success">
                                @* <i class="fas fa-arrow-up me-1"></i>5.8% *@
                            </small>
                        </div>
                        <div class="bg-info bg-opacity-10 p-3 rounded">
                            <i class="fas fa-users-cog text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="row g-3">
        <!-- Activity Timeline -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Recent Activity</h5>
                        <button class="btn btn-link text-decoration-none p-0"><a asp-action="AllActivity">View All</a></button>
                    </div>
                </div>

                <div class="card-body" style="overflow-y:scroll; height:400px;">
                    <div class="timeline">

                        @foreach (var activity in Model.Activity)
                        {
                            @* Notify New User Registration *@
                            <div class="d-flex mb-3">


                                @if (activity.LogLevel == "LogOut")
                                {
                                    <div class="flex-shrink-0">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                                            <i class="fa-solid fa-right-from-bracket text-danger"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-1">User @activity.Exception Has Logged Out</h6>
                                        <p class="text-muted small mb-0">At @(activity.CreatedAt)</p>
                                    </div>

                                }
                                else if (activity.LogLevel == "LOGIN")
                                {
                                    <div class="flex-shrink-0">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                                            <i class="fas fa-sign-in-alt text-primary text-success"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-1">User @activity.Exception Has Logged In</h6>
                                        <p class="text-muted small mb-0">At @(activity.CreatedAt)</p>
                                    </div>
                                }
                                else if (activity.LogLevel == "ResetPwd")
                                {
                                    <div class="flex-shrink-0">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                                            <i class="fa-solid fa-key"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-1">Password Reset Successfuly for User @activity.Exception</h6>
                                        <p class="text-muted small mb-0">At @(activity.CreatedAt)</p>
                                    </div>
                                }
                                else if (activity.LogLevel == "SenResetPwdUrl")
                                {
                                    <div class="flex-shrink-0">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                                            <i class="fa-solid fa-paper-plane text-warning"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-1">Reset Link For User @activity.Exception Has Been Sent Successfully</h6>
                                        <p class="text-muted small mb-0">At @(activity.CreatedAt)</p>
                                    </div>
                                }
                                else if (activity.LogLevel == "REGISTER")
                                {
                                    <div class="flex-shrink-0">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                                            <i class="fas fa-user-plus text-primary"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-1">User @activity.Exception Have Registered. Welcome!</h6>
                                        <p class="text-muted small mb-0">At @(activity.CreatedAt)</p>
                                    </div>
                                }
                                else if (activity.LogLevel == "DEPCREATEINFO")
                                {
                                    <div class="flex-shrink-0">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                                            <i class="fa-solid fa-building-circle-check text-success"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-1">Department @activity.Exception Created by @(User.Identity?.Name ?? "Unkown") </h6>
                                        <p class="text-muted small mb-0">At @(activity.CreatedAt)</p>
                                    </div>
                                }
                                else if (activity.LogLevel == "DEPDELETEINFO")
                                {
                                    <div class="flex-shrink-0">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                                            <i class="fa-solid fa-building-circle-xmark text-danger"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-1">Department @activity.Exception Deleted by @(User.Identity?.Name ?? "Unkown") </h6>
                                        <p class="text-muted small mb-0">At @(activity.CreatedAt)</p>
                                    </div>
                                }
                                else if (activity.LogLevel == "DEPEDITINFO")
                                {
                                    <div class="flex-shrink-0">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                                            <i class="fa-solid fa-building-circle-exclamation text-warning"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-1">Department @activity.Exception Modified by @(User.Identity?.Name ?? "Unkown") </h6>
                                        <p class="text-muted small mb-0">At @(activity.CreatedAt)</p>
                                    </div>
                                }
                                else if (activity.LogLevel == "EMPEDITINFO")
                                {
                                    <div class="flex-shrink-0">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                                            <i class="fa-solid fa-user-pen text-warning"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-1">Employee @activity.Exception Modified by @(User.Identity?.Name ?? "Unkown") </h6>
                                        <p class="text-muted small mb-0">At @(activity.CreatedAt)</p>
                                    </div>
                                }
                                else if (activity.LogLevel == "EMPCREATEINFO")
                                {
                                    <div class="flex-shrink-0">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                                            <i class="fa-solid fa-user-check text-success"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-1">Employee @activity.Exception Created by @(User.Identity?.Name ?? "Unkown") </h6>
                                        <p class="text-muted small mb-0">At @(activity.CreatedAt)</p>
                                    </div>
                                }
                                else if (activity.LogLevel == "EMPDELETEINFO")
                                {
                                    <div class="flex-shrink-0">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                                            <i class="fa-solid fa-user-xmark text-danger"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-1">Employee @activity.Exception Deleted by @(User.Identity?.Name ?? "Unkown") </h6>
                                        <p class="text-muted small mb-0">At @(activity.CreatedAt)</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex-shrink-0">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                                            <i class="fa-solid fa-info-circle"></i>
                                        </div>
                                    </div>
                                }


                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button class="btn btn-outline-primary">
                            <i class="fas fa-plus me-2"></i>Add New Project
                        </button>
                        <button class="btn btn-outline-success">
                            <i class="fas fa-users me-2"></i>Manage Team
                        </button>
                        <button class="btn btn-outline-info">
                            <i class="fas fa-cog me-2"></i>Settings
                        </button>
                        <button class="btn btn-outline-warning">
                            <i class="fas fa-file-alt me-2"></i>Generate Report
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>