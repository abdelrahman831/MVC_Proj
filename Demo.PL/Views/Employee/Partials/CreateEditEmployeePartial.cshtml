@model EmployeeViewModel
@inject IDepartmentService departmentService
@{
    //var departmentList = ViewData["Departments"] as IEnumerable<DepartmentToReturnDto> ?? new List<DepartmentToReturnDto>();
    var Departments = new SelectList(await departmentService.GetAllDepartmentsAsync(), nameof(DepartmentToReturnDto.Id), nameof(DepartmentToReturnDto.Name));

}

<form asp-controller="Employee" asp-action="@ViewBag.Action" method="post" asp-route-id="@Model?.Id" enctype="multipart/form-data" class="mb-5 pb-5">
    <div asp-validation-summary="ModelOnly">  </div>


    <div class="row justify-content-center align-items-lg-start align-items-center">

        <div class="form-group col-6 d-flex flex-column align-items-center">

            <div id="imagePreviewContainer" class="position-relative">
                <!-- Immagine circolare -->
                <img id="imagePreview"
                     src="~/Files/Images/@(Model.ImagePath is not null ? Model.ImagePath : "NotFound.png")"
                     alt="Employee Image"
                     class="rounded-circle shadow-sm"
                     style="width: 150px; height: 150px; object-fit: cover; border: 3px solid #ddd; cursor: pointer;">

                <!-- Icona per la modifica -->
                <div class="position-absolute top-50 start-50 translate-middle">
                    <label for="imageUpload" class="btn btn-sm btn-light p-2 rounded-circle shadow"
                           style="position: absolute; bottom: -10px; right: -10px; cursor: pointer;">
                        <i class="fas fa-camera text-secondary"></i>
                    </label>
                </div>
            </div>

            <input asp-for="Image" type="file" id="imageUpload" class="d-none" accept=".jpg,.jpeg,.png">
        </div>
    </div>
    <div class="row">


        
        <script>
            document.getElementById("imageUpload").addEventListener("change", function (event) {
                const file = event.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        document.getElementById("imagePreview").src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            });

            document.getElementById("imagePreview").addEventListener("click", function () {
                document.getElementById("imageUpload").click();
            });
        </script>
        <!-- Name Field -->
        <div class="form-group col-6">
            <label asp-for="Name" class="form-label">Name</label>
            <input asp-for="Name" type="text" class="form-control" id="Name" name="Name">
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <!-- Email Field -->
        <div class="form-group col-6">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" type="text" class="form-control" id="Email" name="Email">
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <!-- Address Field -->
        <div class="form-group col-6">
            <label asp-for="Address" class="form-label">Address</label>
            <input asp-for="Address" class="form-control">
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <!-- Phone Number Field -->
        <div class="form-group col-6">
            <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
            <input asp-for="PhoneNumber" class="form-control">
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>

        <!-- Age Field -->
        <div class="form-group col-6">
            <label asp-for="Age" class="form-label">Age</label>
            <input asp-for="Age" class="form-control">
            <span asp-validation-for="Age" class="text-danger"></span>
        </div>
        <!-- Hiring Date Field -->
        <div class="form-group col-6">
            <label asp-for="HiringDate" class="form-label">Hiring Date</label>
            <input asp-for="HiringDate" type="date" class="form-control">
            <span asp-validation-for="HiringDate" class="text-danger"></span>
        </div>
        <!-- Salary Field -->
        <div class="form-group col-6">
            <label asp-for="Salary" class="form-label">Salary</label>
            <input asp-for="Salary" class="form-control" type="number" step="0.01">

            <span asp-validation-for="Salary" class="text-danger"></span>
        </div>
        <!-- Gender Field -->
        <div class="form-group col-6">
            <label asp-for="Gender" class="form-label">Gender</label>
            <div>
                @foreach (Gender genderOption in Enum.GetValues(typeof(Gender)))
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="Gender" value="@genderOption">
                        <label asp-for="Gender" class="form-check-label">@genderOption</label>
                    </div>
                }
            </div>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>


        <!-- Employee Type Field -->
        <div class="form-group mb-3">
            <label asp-for="EmployeeType" class="form-label">Employee Type</label>
            <select asp-for="EmployeeType" asp-items="Html.GetEnumSelectList<EmployeeType>()" class="form-control">
                <option value="">Select Employee Type</option>
            </select>
            <span asp-validation-for="EmployeeType" class="text-danger"></span>
        </div>
        <!-- Department Field -->
        <div class="form-group col-6">
            <label asp-for="DepartmentId" class="form-label">Department</label>
            <select asp-for="DepartmentId" class="form-control" asp-items="Departments">
                <option value="">Select Department</option>
            </select>
            <span asp-validation-for="DepartmentId" class="text-danger"></span>
        </div>


        <!-- Image Upload -->




        @* //-----------// *@

        <div class="form-group mb-3">
            <input asp-for="IsActive"  type="checkbox" />
            <label class="col-form-label" asp-for="IsActive">
                I agree to all the terms and conditions and the  <a class="text-decoration-none" asp-controller="Home" asp-action="Privacy">privacy</a> policy of the website
            </label>
            <span asp-validation-for="IsActive" class="text-danger"></span>

        </div>
        <!-- Buttons Section -->
        @if (ViewBag.Action == "Create")
        {
            <div class="d-flex justify-content-center gap-3 mt-3">
                <button type="submit" class="btn btn-primary px-4" style="background-color: #6a0dad; border-color: #6a0dad;">
                    Create
                </button>
                <a asp-controller="Employee" asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
            </div>
        }

        else
        {
            <div class="d-flex justify-content-center gap-3 mt-3">
                <button type="submit" class="btn btn-success px-4" style="background-color: #6a0dad; border-color: #6a0dad;">
                    Save
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary px-4">Back to List</a>
            </div>
        }


</form>