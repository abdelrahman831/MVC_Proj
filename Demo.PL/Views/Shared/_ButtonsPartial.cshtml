@model string
<td class="text-center align-middle">
    <div class="d-flex justify-content-center align-items-center gap-2">
        <a asp-action="Details" asp-route-Id="@Model" data-bs-toggle="tooltip" title="Details" class="icon-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="blue" viewBox="0 0 16 16">
                <path d="M16 8s-3-5-8-5-8 5-8 5 3 5 8 5 8-5 8-5zm-8 4a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm0-1a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
            </svg>
        </a>

        <a asp-action="Edit" asp-route-Id="@Model" data-bs-toggle="tooltip" title="Edit" class="icon-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="green" viewBox="0 0 16 16">
                <path d="M15.502 1.94a1.5 1.5 0 0 1 0 2.121l-1.415 1.415-2.122-2.121 1.415-1.415a1.5 1.5 0 0 1 2.122 0zM14.087 5.46l-8.997 8.997A1.5 1.5 0 0 1 3.08 15H.5v-2.581a1.5 1.5 0 0 1 .439-1.06l8.997-8.997 2.122 2.122z" />
            </svg>
        </a>

        <button type="button" data-bs-toggle="modal" data-bs-target="#deleteModal-@Model" data-bs-toggle="tooltip" title="Delete" class="icon-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="red" viewBox="0 0 16 16">
                <path d="M5.5 5.5a.5.5 0 0 1 .5.5V12a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm5 0a.5.5 0 0 1 .5.5V12a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5z" />
                <path d="M14.5 3a1 1 0 0 1-1 1H13v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1 0-2h3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1h3a1 1 0 0 1 1 1zm-3 1H4v10a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4z" />
            </svg>
        </button>
    </div>
</td>
