@model RoleViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Edit";

}

<h1 class="my-4 w-50 mx-auto text-center fw-bold border-bottom pb-3">Edit Role</h1>


<form asp-controller="Role" asp-action="Edit" method="post" asp-route-id="@Model.Id" enctype="multipart/form-data" class="mb-5 pb-5">
    <div asp-validation-summary="ModelOnly">  </div>


        <!-- Name Field -->
        <div class="form-group col-6 mb-5 align-items-center justify-content-center">
            <label asp-for="Name" class="form-label">Role Name</label>
        <input asp-for="Name" type="text" class="form-control" id="Name" name="Name">
            <span asp-validation-for="Name" class="text-danger"></span>
       



    <h3 class="mt-5">Assign Users To Role</h3>
    <div class="table-wrapper">
        <table class="fl-table">
        <thead>
            <tr>
                <th>Select</th>
                <th>User Name</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.users.Count; i++)
            {
                        <tr class="selectable-row">
                    <td>
                        <input type="hidden" asp-for="@Model.users[i].UserId" />
                        <input type="hidden" asp-for="@Model.users[i].UserName" />
                                <input asp-for="@Model.users[i].IsSelected" class="form-check-input row-checkbox" />
                    </td>
                    <td>
                        <label asp-for="@Model.users[i].IsSelected">@Model.users[i].UserName</label>
                    </td>
                </tr>
            }
        </tbody>
    </table>
   </div>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                document.querySelectorAll(".selectable-row").forEach(row => {
                    let checkbox = row.querySelector(".row-checkbox");

                    // Imposta il colore iniziale se il checkbox è già selezionato
                    if (checkbox.checked) {
                        row.classList.add("selected-row");
                    }

                    row.addEventListener("click", function (event) {
                        if (event.target.type !== "checkbox") {
                            checkbox.checked = !checkbox.checked;
                        }
                        row.classList.toggle("selected-row", checkbox.checked);
                    });

                    checkbox.addEventListener("change", function () {
                        row.classList.toggle("selected-row", checkbox.checked);
                    });
                });
            });
        </script>

        <style>
            .selected-row {
                background-color: #9af3f5 !important; /* Azzurro chiaro per evidenziare */
            }

            .selectable-row {
                cursor: pointer;
            }
        </style>
    </div>


            <div class="d-flex justify-content-center gap-3 mt-3">
                <button type="submit" class="btn btn-success px-4" style="background-color: #6a0dad; border-color: #6a0dad;">
                    Save
                </button>

                <a asp-controller="Role" asp-action="Index" class="btn btn-outline-secondary px-4">Back to List</a>
            </div>
        

</form>